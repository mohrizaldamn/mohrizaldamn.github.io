
/* ===== RESET ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: #08090c;
  color: #ffffff;
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.6;
}

/* ===== NAVIGATION ===== */
nav {
  min-height: 76px;
  padding: 15px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #292a30;
  background: rgba(8, 9, 12, 0.96);
  position: sticky;
  top: 0;
  z-index: 100;
}

.logo {
  font-size: 25px;
  font-weight: 800;
  letter-spacing: 8px;
}

.logo span {
  color: #e82127;
}

nav a {
  color: #ddd;
  text-decoration: none;
  margin-left: 25px;
  font-size: 14px;
  transition: color 0.3s;
}

nav a:hover {
  color: #e82127;
}

/* ===== HERO SECTION ===== */
.hero {
  min-height: 590px;
  padding: 100px 8%;
  display: flex;
  align-items: center;

  background:
    linear-gradient(
      90deg,
      rgba(8, 9, 12, 0.96) 0%,
      rgba(8, 9, 12, 0.72) 48%,
      rgba(8, 9, 12, 0.15) 100%
    ),
    url("https://images.unsplash.com/photo-1560958089-b8a1929cea89?auto=format&fit=crop&w=1800&q=85")
    center / cover no-repeat;
}

.content {
  max-width: 580px;
}

.eyebrow {
  color: #ed2931;
  letter-spacing: 5px;
  font-size: 12px;
  font-weight: bold;
}

h1 {
  font-size: clamp(58px, 10vw, 112px);
  line-height: 1.1;
  margin: 22px 0 8px;
  letter-spacing: 4px;
}

h2 {
  font-size: 30px;
  margin-bottom: 18px;
}

p {
  color: #b9bac3;
  line-height: 1.9;
}

/* ===== BUTTONS ===== */
.buttons {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.btn {
  display: inline-block;
  padding: 14px 25px;
  border-radius: 30px;
  text-decoration: none;
  font-size: 14px;
  transition: 0.3s;
}

.primary {
  background: #e82127;
  color: white;
  border: 1px solid #e82127;
}

.secondary {
  border: 1px solid #888;
  color: white;
}

.btn:hover {
  transform: translateY(-3px);
  filter: brightness(1.2);
}

/* ===== FEATURES ===== */
.features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 55px 6%;
  gap: 25px;
  text-align: center;
}

.feature {
  padding: 18px 10px;
  transition: transform 0.3s;
}

.feature:hover {
  transform: translateY(-5px);
}

.feature .icon {
  font-size: 30px;
  color: #e82127;
  margin-bottom: 15px;
}

.feature h3 {
  font-size: 17px;
  margin-bottom: 10px;
}

.feature p {
  font-size: 13px;
  color: #9698a3;
}

/* ===== ABOUT ===== */
.about {
  text-align: center;
  padding: 75px 20px;
  background: #101116;
}

.about h2 {
  margin-top: 15px;
}

.about p {
  max-width: 650px;
  margin: 15px auto 0;
}

/* ===== FOOTER ===== */
footer {
  text-align: center;
  padding: 28px 15px;
  color: #777;
  font-size: 12px;
  letter-spacing: 3px;
  border-top: 1px solid #202127;
}

footer p {
  font-size: 12px;
  margin-top: 8px;
  letter-spacing: 1px;
}

/* ===== RESPONSIVE MOBILE ===== */
@media (max-width: 700px) {
  nav {
    padding: 15px 5%;
  }

  nav a {
    margin-left: 10px;
    font-size: 12px;
  }

  nav .optional {
    display: none;
  }

  .hero {
    min-height: 540px;
    padding: 70px 7%;
    background-position: 60% center;
  }

  .features {
    grid-template-columns: repeat(2, 1fr);
    padding: 35px 5%;
    gap: 15px;
  }

  h2 {
    font-size: 25px;
  }

  .eyebrow {
    letter-spacing: 3px;
  }
}

@media (max-width: 380px) {
  .logo {
    font-size: 19px;
    letter-spacing: 4px;
  }

  nav a {
    margin-left: 7px;
    font-size: 11px;
  }

  .features {
    grid-template-columns: 1fr;
  }

  .buttons {
    flex-direction: column;
    align-items: flex-start;
  }
}
