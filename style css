/* Reset & Theme Variables */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: 'Montserrat', sans-serif;
}

:root {
  --spidey-red: #ff003c;
  --spidey-red-glow: rgba(255, 0, 60, 0.5);
  --spidey-blue: #00d2ff;
  --spidey-dark: #0a0b10;
  --spidey-card-bg: rgba(18, 20, 29, 0.85);
  --spidey-border: rgba(255, 0, 60, 0.3);
  --text-light: #f1f5f9;
  --text-muted: #94a3b8;
}

html {
  scroll-behavior: smooth;
}

body {
  background-color: var(--spidey-dark);
  color: var(--text-light);
  line-height: 1.6;
  overflow-x: hidden;
  background-image: 
    radial-gradient(circle at 50% 0%, rgba(255, 0, 60, 0.15), transparent 70%),
    radial-gradient(circle at 80% 80%, rgba(0, 210, 255, 0.1), transparent 50%);
}

/* NAVBAR */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem 8%;
  background: rgba(10, 11, 16, 0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--spidey-border);
  z-index: 1000;
}

.logo {
  font-size: 1.8rem;
  font-weight: 900;
  letter-spacing: 2px;
  color: #fff;
  text-decoration: none;
  text-transform: uppercase;
}

.logo span {
  color: var(--spidey-red);
  text-shadow: 0 0 12px var(--spidey-red-glow);
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 2rem;
}

.nav-links a {
  color: var(--text-light);
  text-decoration: none;
  font-weight: 600;
  transition: color 0.3s ease, text-shadow 0.3s ease;
}

.nav-links a:hover {
  color: var(--spidey-red);
  text-shadow: 0 0 8px var(--spidey-red);
}

/* BUTTONS */
.btn-primary {
  background: linear-gradient(135deg, var(--spidey-red), #b3002a);
  color: #fff;
  padding: 0.8rem 1.8rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 700;
  border: none;
  cursor: pointer;
  box-shadow: 0 0 15px var(--spidey-red-glow);
  transition: all 0.3s ease;
  display: inline-block;
  text-align: center;
}

.btn-primary:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 0 25px rgba(255, 0, 60, 0.8);
}

.btn-secondary {
  background: transparent;
  color: var(--text-light);
  padding: 0.8rem 1.8rem;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 700;
  border: 2px solid var(--spidey-red);
  transition: all 0.3s ease;
  display: inline-block;
}

.btn-secondary:hover {
  background: var(--spidey-red);
  box-shadow: 0 0 15px var(--spidey-red-glow);
}

.btn-full {
  width: 100%;
}

/* HERO SECTION */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8%;
  padding-top: 80px;
}

.hero-content {
  max-width: 600px;
  z-index: 2;
}

.tagline {
  display: inline-block;
  background: rgba(255, 0, 60, 0.15);
  border: 1px solid var(--spidey-red);
  color: var(--spidey-red);
  padding: 0.4rem 1rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 1px;
  margin-bottom: 1.5rem;
  text-shadow: 0 0 5px var(--spidey-red-glow);
}

.hero-content h1 {
  font-size: 3.5rem;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 1.2rem;
  text-transform: uppercase;
}

.hero-content h1 span {
  color: var(--spidey-red);
  background: linear-gradient(135deg, #ff003c, #ff4d6d);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-content p {
  color: var(--text-muted);
  font-size: 1.1rem;
  margin-bottom: 2rem;
}

.hero-buttons {
  display: flex;
  gap: 1.2rem;
}

.hero-image {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
}

.glow-ring {
  position: absolute;
  width: 380px;
  height: 380px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--spidey-red-glow) 0%, transparent 70%);
  animation: pulse 3s infinite ease-in-out;
}

.hero-image img {
  width: 100%;
  max-width: 420px;
  border-radius: 20px;
  filter: drop-shadow(0 0 35px rgba(255, 0, 60, 0.6));
  animation: float 4s ease-in-out infinite;
  position: relative;
  z-index: 3;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

@keyframes pulse {
  0%, 100% { transform: scale(0.9); opacity: 0.6; }
  50% { transform: scale(1.1); opacity: 1; }
}

/* STATS BAR */
.stats-bar {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 2rem;
  padding: 3rem 8%;
  background: rgba(18, 20, 29, 0.6);
  border-top: 1px solid var(--spidey-border);
  border-bottom: 1px solid var(--spidey-border);
  text-align: center;
}

.stat-item h3 {
  font-size: 2.5rem;
  font-weight: 900;
  color: var(--spidey-red);
  text-shadow: 0 0 10px var(--spidey-red-glow);
}

.stat-item p {
  color: var(--text-muted);
  font-size: 0.9rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* CARDS / SUITS SECTION */
.suits-section {
  padding: 6rem 8%;
}

.section-title {
  text-align: center;
  margin-bottom: 4rem;
}

.section-title h2 {
  font-size: 2.5rem;
  font-weight: 800;
  text-transform: uppercase;
}

.section-title p {
  color: var(--text-muted);
}

.suits-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2.5rem;
}

.suit-card {
  background: var(--spidey-card-bg);
  border: 1px solid var(--spidey-border);
  border-radius: 16px;
  padding: 2.5rem 2rem;
  transition: all 0.4s ease;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.suit-card.highlighted {
  border-color: var(--spidey-red);
  box-shadow: 0 0 20px var(--spidey-red-glow);
}

.suit-badge {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: var(--spidey-red);
  color: #fff;
  font-size: 0.75rem;
  font-weight: 800;
  padding: 0.3rem 0.8rem;
  border-radius: 20px;
}

.suit-badge.alt {
  background: var(--spidey-blue);
  color: #000;
}

.suit-icon {
  font-size: 2.5rem;
  color: var(--spidey-red);
  margin-bottom: 1rem;
}

.suit-card h3 {
  font-size: 1.5rem;
  margin-bottom: 0.8rem;
}

.suit-card p {
  color: var(--text-muted);
  font-size: 0.95rem;
  margin-bottom: 1.5rem;
}

.suit-features {
  list-style: none;
  margin-bottom: 2rem;
  margin-top: auto;
}

.suit-features li {
  color: var(--text-light);
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
}

.suit-features i {
  color: var(--spidey-red);
  margin-right: 0.5rem;
}

.suit-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 10px 30px rgba(255, 0, 60, 0.3);
}

/* FORM SECTION */
.contact-section {
  padding: 6rem 8%;
  display: flex;
  justify-content: center;
}

.form-card {
  background: var(--spidey-card-bg);
  border: 1px solid var(--spidey-border);
  padding: 3rem;
  border-radius: 20px;
  width: 100%;
  max-width: 600px;
  box-shadow: 0 0 30px rgba(0, 0, 0, 0.8);
}

.form-header {
  text-align: center;
  margin-bottom: 2rem;
}

.form-header h2 {
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.form-header p {
  color: var(--text-muted);
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-group label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  padding: 0.9rem 1.2rem;
  background: rgba(10, 11, 16, 0.8);
  border: 1px solid var(--spidey-border);
  border-radius: 8px;
  color: #fff;
  outline: none;
  transition: border-color 0.3s ease;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border-color: var(--spidey-red);
  box-shadow: 0 0 10px var(--spidey-red-glow);
}

/* FOOTER */
footer {
  text-align: center;
  padding: 2rem;
  background: rgba(10, 11, 16, 0.95);
  border-top: 1px solid var(--spidey-border);
  color: var(--text-muted);
  font-size: 0.9rem;
}

/* RESPONSIVE DESIGN */
@media (max-width: 992px) {
  .hero {
    flex-direction: column;
    text-align: center;
    padding-top: 120px;
    gap: 3rem;
  }

  .hero-buttons {
    justify-content: center;
  }

  .nav-links {
    display: none;
  }

  .hero-content h1 {
    font-size: 2.5rem;
  }
}
